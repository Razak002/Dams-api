NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/dams-api
JWT_SECRET=replace-with-a-long-random-secret-key
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
